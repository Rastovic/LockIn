<?xml version="1.0" encoding="utf-8"?>
<!--
  Full screen and opaque, so nothing of the covered app shows through. Colours
  are set in BlockActivity from the theme picked in the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/widget_bg"
    android:padding="32dp">

    <TextView
        android:id="@+id/block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/widget_ink" />

    <TextView
        android:id="@+id/block_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="44sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/widget_accent" />

    <TextView
        android:id="@+id/block_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/block_body"
        android:textSize="15sp"
        android:textColor="@color/widget_ink_muted" />

    <Button
        android:id="@+id/block_open"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:text="@string/block_open"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:background="@drawable/block_button" />

    <Button
        android:id="@+id/block_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/block_continue"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/widget_ink_muted"
        android:background="@android:color/transparent" />

    <Button
        android:id="@+id/block_close"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/block_close"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/widget_ink_muted"
        android:background="@android:color/transparent" />
</LinearLayout>
